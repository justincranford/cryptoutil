package __SERVICE__

import (
	"bytes"
	"testing"

	cryptoutilTestCli "cryptoutil/internal/apps-framework/service/test_help_cli"
	cryptoutilSharedMagic "cryptoutil/internal/shared/magic"

	"github.com/stretchr/testify/require"
)

func Test__USAGE_PREFIX__(t *testing.T) {
	t.Parallel()

	cryptoutilTestCli.RunCLITests(t, __ENTRY_FUNC__)
}

func TestStartupzHelp(t *testing.T) {
	t.Parallel()

	var stdout, stderr bytes.Buffer

	exitCode := __ENTRY_FUNC__([]string{"startupz", cryptoutilSharedMagic.CLIHelpFlag}, nil, &stdout, &stderr)

	require.Zero(t, exitCode)
	require.Empty(t, stdout.String())
	require.Contains(t, stderr.String(), "Usage: "+cryptoutilSharedMagic.__PRODUCT_NAME_CONST__+" "+cryptoutilSharedMagic.__SERVICE_NAME_CONST__+" startupz [options]")
	require.Contains(t, stderr.String(), "GET /admin/api/v1/startupz")
	require.Contains(t, stderr.String(), cryptoutilSharedMagic.CLICACertFlag)
	require.Contains(t, stderr.String(), cryptoutilSharedMagic.CLICertFlag)
	require.Contains(t, stderr.String(), cryptoutilSharedMagic.CLIKeyFlag)
}
